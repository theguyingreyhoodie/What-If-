{
  "name": "what-if-simulator",
  "version": "0.1.0",
  "description": "Alternate-history what-if simulator powered by Claude",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:demo": "DEMO=1 npm run dev",
    "build": "tsc -p . && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theguyingreyhoodie/What-If-.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/theguyingreyhoodie/What-If-/issues"
  },
  "homepage": "https://github.com/theguyingreyhoodie/What-If-#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
